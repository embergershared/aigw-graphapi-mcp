<Project>
  <!-- Central Package Management: every NuGet version is set here, once, and projects use
       <PackageReference Include="..." /> without a Version. A new version must be at least
       7 days old (CI checks the lock files). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" /> -->
  </ItemGroup>
</Project>
