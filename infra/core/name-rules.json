{
  "$comment": "Azure resource-name rules. 'classes' are the naming strategies a catalog module selects through its metadata.json 'nameRule' field. 'resources' are the per-resource-type constraints the rules test enforces against rendered names.",
  "classes": {
    "regional": {
      "description": "Hyphenated regional name: <abbreviation>-[<tenant>-]<location>-<subscription>-<environment>[-<suffix>]. The default for anything that is not globally unique.",
      "separator": "-",
      "case": "lower",
      "charset": "^[a-z0-9-]+$",
      "truncates": false
    },
    "global": {
      "description": "Globally unique hyphenated name constrained to a character budget. Only the environment segment truncates. Used by Key Vault.",
      "separator": "-",
      "case": "lower",
      "charset": "^[a-z0-9-]+$",
      "budget": 24,
      "truncates": true
    },
    "globalCompact": {
      "description": "Globally unique name with no separators, for resources that forbid hyphens. Used by storage accounts.",
      "separator": "",
      "case": "lower",
      "charset": "^[a-z0-9]+$",
      "budget": 24,
      "truncates": true
    },
    "hostname": {
      "description": "Short hostname-style name, such as a 15-character Windows computer name.",
      "separator": "-",
      "case": "lower",
      "charset": "^[a-z0-9-]+$",
      "budget": 15,
      "truncates": true
    },
    "fixed": {
      "description": "Azure-mandated literal name that must not be generated, such as AzureBastionSubnet.",
      "separator": "",
      "case": "exact",
      "charset": "^[A-Za-z0-9-]+$",
      "truncates": false
    }
  },
  "resources": {
    "resourceGroup": { "maxLength": 90, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "subscription", "class": "regional" },
    "virtualNetwork": { "maxLength": 64, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "bastionNsg": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "jumpboxNsg": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "privateEndpointNsg": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "jumpboxSubnet": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "virtualNetwork", "class": "regional" },
    "privateEndpointSubnet": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "virtualNetwork", "class": "regional" },
    "keyVault": { "maxLength": 24, "minLength": 3, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "global", "class": "global" },
    "keyVaultPrivateEndpoint": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "keyVaultPrivateEndpointNic": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "storageAccount": { "maxLength": 24, "minLength": 3, "charset": "^[a-z0-9]+$", "case": "lower", "scope": "global", "class": "globalCompact" },
    "blobPrivateEndpoint": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "blobPrivateEndpointNic": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "filePrivateEndpoint": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "filePrivateEndpointNic": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "logAnalytics": { "maxLength": 63, "minLength": 4, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "applicationInsights": { "maxLength": 255, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "natGateway": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "natPublicIp": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "bastion": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "bastionPublicIp": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "windowsVm": { "maxLength": 64, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "windowsComputerName": { "maxLength": 15, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "virtualMachine", "class": "hostname" },
    "windowsNic": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "linuxVm": { "maxLength": 64, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "linuxNic": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "containerAppsNsg": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "containerAppsSubnet": { "maxLength": 80, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "virtualNetwork", "class": "regional" },
    "containerAppsEnvironment": { "maxLength": 60, "minLength": 2, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "managedResourceGroup": { "maxLength": 90, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "subscription", "class": "regional" },
    "containerApp": { "maxLength": 32, "minLength": 2, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "containerRegistry": { "maxLength": 50, "minLength": 5, "charset": "^[a-z0-9]+$", "case": "lower", "scope": "global", "class": "globalCompact" },
    "managedIdentity": { "maxLength": 128, "minLength": 3, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" },
    "aiFoundry": { "maxLength": 64, "minLength": 2, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "global", "class": "global" },
    "aiFoundryProject": { "maxLength": 64, "minLength": 2, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "aiFoundry", "class": "regional" },
    "mapsAccount": { "maxLength": 98, "minLength": 1, "charset": "^[a-z0-9-]+$", "case": "lower", "scope": "resourceGroup", "class": "regional" }
  },
  "reserved": {
    "AzureBastionSubnet": "Azure mandates this exact subnet name for Azure Bastion. It must never be generated from the naming convention."
  }
}
