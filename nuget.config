<?xml version="1.0" encoding="utf-8"?>
<!-- Approved package feed only: no nuget.org fallback. Restores fail closed when a package
     or version is not on the feed. -->
<configuration>
  <packageSources>
    <clear />
    <add key="packagefeedproxy" value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json" />
  </packageSources>
</configuration>
